# Server
PORT=5000
NODE_ENV=production

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pharmacy?schema=public"

# JWT
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_ACCESS_EXPIRES_IN=15m

# Frontend
FRONTEND_URL=https://your-domain.com

# Admin seed
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@yourpharmacy.com
ADMIN_PASSWORD=ChangeMe@123

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="MediSuite <your@gmail.com>"

# OTP settings
EMAIL_OTP_EXP_MIN=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SEC=60

# Password reset
RESET_CODE_TTL_MINUTES=10
RESET_CODE_PEPPER=replace-with-long-random-string
RESET_TOKEN_SECRET=replace-with-another-long-random-string
